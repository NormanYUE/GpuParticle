<Project>
  <PropertyGroup>
    <UnityEditorVersion Condition="'$(UnityEditorVersion)' == ''">2022.3.62f2</UnityEditorVersion>
    <UnityEditorRoot Condition="'$(UnityEditorRoot)' == ''">/Applications/Unity/Hub/Editor/$(UnityEditorVersion)/Unity.app/Contents</UnityEditorRoot>
    <UnityEngineManaged>$(UnityEditorRoot)/Managed/UnityEngine</UnityEngineManaged>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <TargetFramework>netstandard2.1</TargetFramework>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
